---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { team } from "../data/site";
---

<PageLayout
  title="Our Team — Cominsky Family Foundation"
  description="Meet John and Brittany Cominsky, the Barberton natives behind the Cominsky Family Foundation."
>
  <PageHero
    eyebrow="Our Team"
    title="The people<br />pushing the rock"
    intro="A 501(c)(3) run by two Barberton, Ohio natives who never forgot where they came from."
  />

  <section class="container section team container--mid">
    {team.map((member, i) => (
      <article
        class:list={["member", i % 2 === 1 && "member--reverse"]}
        data-reveal-group="120"
      >
        <figure class="member__media mo-zoom" data-reveal="media">
          <img
            src={member.image}
            alt={member.alt}
            class="img-cover"
            style={member.objectPosition ? `object-position: ${member.objectPosition}` : undefined}
            loading="lazy"
          />
        </figure>
        <div class="member__copy">
          <p class="eyebrow" data-reveal="up">{member.role}</p>
          <h2 class="member__name" data-split="words" data-split-step="70">{member.name}</h2>
          {member.bio.map((p) => <p class="member__bio" data-reveal="up">{p}</p>)}
        </div>
      </article>
    ))}
  </section>

  <CtaBand
    eyebrow="Join Us"
    title="Want to help us do more?"
    body="Every dollar and every volunteer hour goes straight back into the community."
  />
</PageLayout>

<style>
  .team {
    display: grid;
    gap: 90px;
  }
  .member {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: center;
  }
  .member--reverse .member__media { order: 2; }
  .member__media {
    height: 480px;
    overflow: hidden;
    border-radius: var(--radius);
    margin: 0;
  }
  .member__name {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 8px 0 20px;
    font-weight: 500;
  }
  .member__copy .eyebrow { margin-bottom: 8px; }
  .member__bio {
    font-size: 16px;
    line-height: 1.75;
    color: var(--c-body);
    margin: 0 0 16px;
  }

  @media (max-width: 860px) {
    .member,
    .member--reverse { grid-template-columns: 1fr; gap: 28px; }
    .member--reverse .member__media { order: 0; }
    .member__media { height: 60vw; max-height: 460px; }
  }
</style>
