---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
---

<PageLayout
  title="Merchandise — Cominsky Family Foundation"
  description="Cominsky Family Foundation merch is coming soon. 100% of proceeds support our initiatives. Join the waitlist."
>
  <PageHero
    eyebrow="Merch"
    title="Available soon"
    intro="Cominsky Family Foundation merch is on the way — 100% of proceeds support the continuity of our initiatives."
  />

  <section class="container container--narrow section merch" data-reveal-group="130">
    <div class="merch__badge" data-reveal="scale">Coming Soon</div>
    <h2 class="merch__headline" data-split="words" data-split-step="80">Be first in line</h2>
    <p class="merch__body" data-reveal="up">
      Drop your email and we'll let you know the moment it's live. Feel free to
      reach out with sizes or design requests as we develop the collection.
    </p>

    <form class="merch__form" name="merch-waitlist" method="post" data-reveal="up">
      <input
        type="email"
        name="email"
        placeholder="Your email"
        required
        class="merch__input"
        aria-label="Email address"
      />
      <button type="submit" class="btn btn--primary merch__submit" disabled>Join the waitlist</button>
    </form>

    <p class="merch__note" data-reveal="fade">
      Questions or ideas? Email
      <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </section>
</PageLayout>

<style>
  .merch {
    text-align: center;
    max-width: 640px;
  }
  .merch__badge {
    display: inline-block;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--c-purple);
    border: 1px solid var(--c-line);
    border-radius: 999px;
    padding: 8px 18px;
    margin-bottom: 26px;
    font-family: var(--font-label);
  }
  .merch__headline {
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 48px);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 16px;
    font-weight: 500;
  }
  .merch__body {
    font-size: 16px;
    line-height: 1.75;
    color: var(--c-body);
    margin: 0 auto 30px;
  }
  .merch__form {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .merch__input {
    flex: 1;
    min-width: 240px;
    max-width: 360px;
    padding: 14px 16px;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    font-size: 14px;
  }
  .merch__input:focus-visible {
    outline: 2px solid var(--c-purple);
    outline-offset: 1px;
    border-color: var(--c-purple);
  }
  .merch__submit { padding: 14px 26px; font-size: 14px; }
  .merch__note {
    font-size: 16px;
    color: var(--c-muted);
    font-family: var(--font-label);
  }

  @media (max-width: 480px) {
    .merch__form { flex-direction: column; }
    .merch__input { max-width: none; }
  }
</style>
