---
import PageLayout from "../../layouts/PageLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { events, links } from "../../data/site";

export const prerender = true;

export function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const registerUrl = event.registerUrl ?? links.donate;
---

<PageLayout
  title={`${event.title} — Cominsky Family Foundation`}
  description={event.detailHtml?.replace(/<[^>]+>/g, "").slice(0, 155)}
>
  <article>
    <section class="ev-hero">
      <img src={event.image} alt={event.alt} class="ev-hero__bg" data-parallax="34" />
      <div class="ev-hero__inner container" data-reveal-group="120">
        <a href="/events" class="ev-hero__back" data-reveal="fade">
          <span class="mo-arrow mo-arrow--back">←</span> All Events
        </a>
        <span
          class:list={["ev-hero__status", `ev-hero__status--${event.statusKind}`]}
          data-reveal="scale"
        >
          {event.statusLabel}
        </span>
        <h1 class="ev-hero__title" data-split="words" data-split-step="75">{event.title}</h1>
        <p class="ev-hero__term" data-reveal="up">{event.term}</p>
      </div>
    </section>

    <section class="container container--narrow section ev-body" data-reveal-group="100">
      {event.location && (
        <p class="ev-meta" data-reveal="up"><span>Where</span>{event.location}</p>
      )}
      <p class="ev-meta" data-reveal="up"><span>When</span>{event.term}</p>

      <div class="ev-copy" data-reveal="up" set:html={event.detailHtml ?? event.bodyHtml} />

      <div id="register" class="ev-actions" data-reveal="up">
        <a href={registerUrl} class="btn btn--gold btn--lg" target="_blank" rel="noopener noreferrer">
          {event.statusKind === "closed" ? "Join the waitlist" : "Register / Support"}
        </a>
        <a href="/contact-us" class="ev-ghost">Questions? Contact us <span class="mo-arrow">→</span></a>
      </div>
    </section>

    <CtaBand
      title="Help us put on the next one"
      body="Our events run on community support. Chip in and keep them free for the kids."
    />
  </article>
</PageLayout>

<style>
  .ev-hero {
    position: relative;
    background: var(--c-ink-900);
    overflow: hidden;
  }
  .ev-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
    /* Wider crop so the parallax drift never exposes an edge. */
    --mo-pscale: 1.24;
  }
  .ev-hero__inner {
    position: relative;
    padding-block: 90px 70px;
    color: var(--c-cream);
  }
  .ev-hero__back {
    display: inline-block;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--c-cream);
    margin-bottom: 26px;
    font-family: var(--font-label);
    margin-right: 8px;
  }
  .ev-hero__back:hover { color: var(--c-gold); }
  .ev-hero__status {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: var(--radius);
    margin-bottom: 16px;
    font-family: var(--font-label);
  }
  .ev-hero__status--open { background: var(--c-gold); color: var(--c-ink); }
  .ev-hero__status--closed { background: var(--c-white); color: var(--c-ink); }
  .ev-hero__status--upcoming { background: rgba(245,246,249,0.2); color: var(--c-cream); }
  .ev-hero__title {
    font-family: var(--font-display);
    font-size: clamp(38px, 6vw, 76px);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
    max-width: 900px;
    font-weight: 500;
  }
  .ev-hero__term {
    margin: 20px 0 0;
    font-size: 15px;
    letter-spacing: 1px;
    color: #e7e4df;
  }

  .ev-meta {
    display: flex;
    gap: 18px;
    font-size: 15px;
    color: var(--c-body);
    padding: 14px 0;
    border-bottom: 1px solid var(--c-border);
    margin: 0;
  }
  .ev-meta:first-child { border-top: 1px solid var(--c-border); }
  .ev-meta span {
    flex-shrink: 0;
    width: 80px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--c-stone);
    padding-top: 2px;
  }
  .ev-copy {
    margin: 40px 0 0;
    font-size: 17px;
    line-height: 1.8;
    color: var(--c-body);
  }
  .ev-actions {
    display: flex;
    align-items: center;
    gap: 26px;
    margin-top: 44px;
    flex-wrap: wrap;
  }
  .ev-ghost {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--c-ink);
    border-bottom: 2px solid var(--c-gold);
    padding-bottom: 3px;
    font-family: var(--font-label);
  }
  .ev-ghost:hover { color: var(--c-purple); }

  @media (max-width: 760px) {
    .ev-actions { justify-content: center; }
  }
</style>
