---
import { getSiteSettings } from "emdash";
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import PostCard from "../../../components/PostCard.astro";
import BlogPager from "../../../components/BlogPager.astro";
import { getBlogPage } from "../../../utils/blog-pagination";
import { getReadingTime } from "../../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../../utils/site-identity";

const pageNumber = Number(Astro.params.page);

if (!Number.isInteger(pageNumber) || pageNumber < 2) {
	return Astro.redirect("/blog");
}

const [{ postsWithTags, currentPage, hasNext, hasPrev }, settings] = await Promise.all([
	getBlogPage(pageNumber),
	getSiteSettings(),
]);

if (postsWithTags.length === 0) {
	return Astro.redirect("/blog");
}

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
---

<Base title={`${siteTitle} — Page ${pageNumber}`} description={siteTagline}>
	<PageHero
		eyebrow="Blog"
		title="Stories from the Foundation"
		intro="Updates, news, and stories from the Cominsky Family Foundation."
	/>

	<div class="home-content">
		<section class="posts-section">
			<div class="posts-grid">
				{postsWithTags.map(({ post, tags, bylines }) => (
					<PostCard
						title={post.data.title ?? "Untitled"}
						excerpt={post.data.excerpt}
						featuredImage={post.data.featured_image}
						href={`/blog/${post.id}`}
						date={post.data.publishedAt ?? undefined}
						readingTime={getReadingTime(post.data.content)}
						tags={tags}
						bylines={bylines}
					/>
				))}
			</div>
			<BlogPager currentPage={currentPage} hasPrev={hasPrev} hasNext={hasNext} />
		</section>
	</div>
</Base>

<style>
	.home-content {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	@media (max-width: 900px) {
		.home-content {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--spacing-8) var(--spacing-6);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-8);
		}
	}
</style>
