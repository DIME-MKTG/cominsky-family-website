---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Mission from "../components/Mission.astro";
import MottoBand from "../components/MottoBand.astro";
import Initiatives from "../components/Initiatives.astro";
import GoalBar from "../components/GoalBar.astro";
import StoryStrip from "../components/StoryStrip.astro";
import Events from "../components/Events.astro";
import Family from "../components/Family.astro";
import Testimonial from "../components/Testimonial.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <Mission />
    <MottoBand />
    <Initiatives />
    <GoalBar />
    <StoryStrip />
    <Events />
    <Family />
    <Testimonial />
    <Contact
      eyebrow="Contact Us"
      title="Get in touch"
      body="Help us inspire communities and build cultures to be proud of - attacking the unmet needs there."
    />
  </main>
  <Footer />
</BaseLayout>
