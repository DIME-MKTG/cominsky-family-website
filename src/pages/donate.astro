---
import { links } from "../data/site";
const target = links.donate;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting to donation — Cominsky Family Foundation</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
  </head>
  <body>
    <p style="font-family: sans-serif; padding: 40px; text-align: center;">
      Redirecting to our secure donation page…
      <br />
      If you are not redirected, <a href={target}>click here to donate</a>.
    </p>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </body>
</html>
