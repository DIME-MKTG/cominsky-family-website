---
import type { MediaValue, ContentBylineCredit } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	href: string;
	date?: Date;
	readingTime?: number;
	tags?: Array<{ slug: string; label: string }>;
	bylines?: ContentBylineCredit[];
}

const {
	title,
	excerpt,
	featuredImage,
	href,
	date,
	readingTime,
	tags,
	bylines,
} = Astro.props;

const formattedDate = date
	? date.toLocaleDateString("en-US", {
			year: "numeric",
			month: "short",
			day: "numeric",
		})
	: null;

const byline = bylines?.[0]?.byline;
const metaBits = [
	byline?.displayName,
	formattedDate,
	readingTime ? `${readingTime} min read` : null,
].filter(Boolean);
---

<article class="pcard mo-lift" data-reveal="up">
	<a href={href} class="pcard__media mo-zoom" aria-label={title}>
		{
			featuredImage ? (
				<div class="pcard__image">
					<Image image={featuredImage} />
				</div>
			) : (
				<div class="pcard__placeholder" />
			)
		}
	</a>
	<div class="pcard__body">
		{metaBits.length > 0 && <span class="pcard__term">{metaBits.join(" · ")}</span>}
		<h3 class="pcard__title"><a href={href}>{title}</a></h3>
		{excerpt && <p class="pcard__desc">{excerpt}</p>}
		{
			tags && tags.length > 0 && (
				<div class="pcard__tags">
					{tags.slice(0, 2).map((tag) => (
						<span class="pcard__tag">{tag.label}</span>
					))}
				</div>
			)
		}
		<a href={href} class="pcard__link">
			Read post <span class="mo-arrow">→</span>
		</a>
	</div>
</article>

<style>
	.pcard {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--c-border);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--c-white);
	}

	.pcard__media {
		position: relative;
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--c-line);
	}

	.pcard__image,
	.pcard__image :global(img) {
		width: 100%;
		height: 100%;
	}

	.pcard__image :global(img) {
		object-fit: cover;
	}

	.pcard__placeholder {
		width: 100%;
		height: 100%;
		background: var(--c-line);
	}

	.pcard__body {
		padding: 26px 26px 30px;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.pcard__term {
		font-size: 13px;
		letter-spacing: 1.5px;
		font-weight: 700;
		color: var(--c-stone);
		text-transform: uppercase;
		font-family: var(--font-label);
	}

	.pcard__title {
		font-family: var(--font-display);
		font-size: 22px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		margin: 12px 0 10px;
		font-weight: 500;
	}

	.pcard__title a {
		color: var(--c-ink);
	}

	.pcard__title a:hover {
		color: var(--c-purple);
	}

	.pcard__desc {
		font-size: 16px;
		line-height: 1.7;
		color: var(--c-muted);
		margin: 0 0 20px;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.pcard__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 20px;
	}

	.pcard__tag {
		display: inline-block;
		padding: 3px 10px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.3px;
		color: var(--c-stone);
		background: var(--c-cream);
		border-radius: var(--radius);
	}

	.pcard__tag:hover {
		color: var(--c-purple);
	}

	.pcard__link {
		margin-top: auto;
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		color: var(--c-purple);
		font-family: var(--font-label);
	}
</style>
