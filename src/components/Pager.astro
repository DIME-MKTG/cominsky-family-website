---
interface Props {
	basePath: string;
	currentPage: number;
	hasPrev: boolean;
	hasNext: boolean;
	prevLabel?: string;
	nextLabel?: string;
}

const {
	basePath,
	currentPage,
	hasPrev,
	hasNext,
	prevLabel = "Newer",
	nextLabel = "Older",
} = Astro.props;

const pageHref = (page: number) => (page === 1 ? basePath : `${basePath}/page/${page}`);
---

{
	(hasPrev || hasNext) && (
		<nav class="pager" aria-label="Pagination">
			{hasPrev ? (
				<a href={pageHref(currentPage - 1)} class="pager__link pager__link--prev">
					<span class="mo-arrow mo-arrow--back">←</span> {prevLabel}
				</a>
			) : (
				<span />
			)}
			{hasNext && (
				<a href={pageHref(currentPage + 1)} class="pager__link pager__link--next">
					{nextLabel} <span class="mo-arrow">→</span>
				</a>
			)}
		</nav>
	)
}

<style>
	.pager {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 48px;
		padding-top: 32px;
		border-top: 1px solid var(--c-border);
	}

	.pager__link {
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		color: var(--c-purple);
		font-family: var(--font-label);
	}

	.pager__link:hover {
		color: var(--c-purple-hover);
	}

	.pager__link--next {
		margin-inline-start: auto;
	}
</style>
