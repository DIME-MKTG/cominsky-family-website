---
import { getEmDashCollection } from "emdash";

type EventEntry = Awaited<ReturnType<typeof getEmDashCollection>>["entries"][number];

interface Props {
  event: EventEntry;
}

const { event } = Astro.props;
---

<article class="event" data-reveal-group="80">
  <div class="event__head" data-reveal="up">
    <span class="event__term">{event.data.term}</span>
    <span class:list={["event__status", `event__status--${event.data.status_kind}`]}>
      {event.data.status_label}
    </span>
  </div>
  <h3 class="event__title" data-reveal="mask">{event.data.title}</h3>
  <p class="event__body" data-reveal="up" set:html={event.data.body} />
  <div class="event__media mo-zoom" data-reveal="media">
    <img src={event.data.image} alt={event.data.alt ?? ""} class="img-cover" loading="lazy" />
  </div>
</article>

<style>
  .event {
    padding: 40px 0;
    margin: 0;
  }
  .event__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }
  .event__term {
    font-size: 14px;
    letter-spacing: 2px;
    font-weight: 700;
    color: var(--c-stone);
    text-transform: uppercase;
    font-family: var(--font-label);
  }
  .event__status {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 4px 10px;
    border-radius: var(--radius);
    text-transform: uppercase;
    white-space: nowrap;
    font-family: var(--font-label);
  }
  .event__status--closed {
    background: var(--c-ink);
    color: var(--c-cream);
  }
  .event__status--open {
    background: var(--c-gold);
    color: var(--c-ink);
    font-weight: 800;
  }
  .event__title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 12px;
  }
  .event__body {
    font-size: 16px;
    line-height: 1.7;
    color: var(--c-muted);
    margin: 0 0 22px;
  }
  .event__body :global(a) { font-weight: 700; }
  .event__media {
    height: 240px;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .event:hover .event__media img { transform: scale(1.04); }
</style>
