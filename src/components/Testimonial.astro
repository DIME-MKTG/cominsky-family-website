<section class="testimonial container container--tight" data-reveal-group="150">
  <p class="testimonial__mark" aria-hidden="true" data-reveal="scale">&ldquo;</p>
  <blockquote class="testimonial__quote" data-reveal="up">
    Love seeing your dedication to the youth of our area! <br>
Thank you.
  </blockquote>
  <p class="testimonial__cite" data-reveal="fade">Duane Milford · Barberton, Ohio</p>
</section>

<style>
  .testimonial {
    padding-block: 110px;
    text-align: center;
  }
  .testimonial__mark {
    font-family: var(--font-display);
    font-size: 40px;
    color: var(--c-gold);
    line-height: 0.5;
    margin: 0 0 22px;
  }
  .testimonial__quote {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.55;
    color: var(--c-ink);
    font-style: italic;
    margin: 0 0 20px;
    letter-spacing: -1px;
  }
  .testimonial__cite {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--c-stone);
    margin: 0;
    font-family: var(--font-label);
  }

  @media (max-width: 760px) {
    .testimonial { padding-block: 72px; }
    .testimonial__quote { font-size: 20px; }
  }
</style>
