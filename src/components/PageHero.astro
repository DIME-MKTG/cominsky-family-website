---
/**
 * Interior-page hero, styled in the homepage's language: eyebrow + big display type
 * title + optional intro. Optionally full-bleed over a background image.
 */
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
}

const { eyebrow, title, intro, image, imageAlt = "" } = Astro.props;
const hasImage = Boolean(image);
---

<section class:list={["page-hero", hasImage && "page-hero--image"]}>
  {hasImage && (
    <img
      src={image}
      alt={imageAlt}
      class="page-hero__bg"
      data-parallax="34"
    />
  )}
  <div class="page-hero__inner container" data-reveal-group="130">
    <p class:list={["eyebrow", hasImage && "eyebrow--gold"]} data-reveal="up">{eyebrow}</p>
    <h1 class="page-hero__title" data-split="words" data-split-step="80" set:html={title} />
    {intro && <p class="page-hero__intro" data-reveal="up">{intro}</p>}
  </div>
</section>

<style>
  .page-hero {
    border-bottom: 1px solid var(--c-border);
  }
  .page-hero__inner {
    padding-block: 90px 70px;
  }
  .page-hero .eyebrow { margin-bottom: 18px; }
  .page-hero__title {
    font-family: var(--font-display);
    font-size: clamp(44px, 7vw, 96px);
    line-height: 0.98;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--c-ink);
    margin: 0;
    font-weight: 500;
  }
  .page-hero__intro {
    max-width: 620px;
    margin: 26px 0 0;
    font-size: 18px;
    line-height: 1.75;
    color: var(--c-body);
  }

  /* Image variant: light text over a darkened photo */
  .page-hero--image {
    position: relative;
    background: var(--c-ink-900);
    border-bottom: none;
    overflow: hidden;
  }
  .page-hero--image .page-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
    /* Wider crop so the parallax drift never exposes an edge. */
    --mo-pscale: 1.24;
  }
  .page-hero--image .page-hero__inner {
    position: relative;
    padding-block: 130px 110px;
  }
  .page-hero--image .page-hero__title { color: var(--c-cream); }
  .page-hero--image .page-hero__intro { color: #e7e4df; }

  @media (max-width: 760px) {
    .page-hero__inner { padding-block: 56px 44px; }
    .page-hero--image .page-hero__inner { padding-block: 90px 72px; }
  }
</style>
