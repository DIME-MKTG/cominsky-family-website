{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cominsky-family-website",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cominsky-family-website","database_id": "b3de6fdb-9f56-4bcb-9618-90d87c89113b",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "cominsky-family-website","preview_bucket_name": "cominsky-family-website",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
